# The existing CloudDrive2 container and Qdrant listener on the deployment host.
MEMORYBRIDGE_BACKUP_QDRANT_URL=http://127.0.0.1:6333
MEMORYBRIDGE_BACKUP_COLLECTIONS=memorybridge_raw,memorybridge_meta
MEMORYBRIDGE_BACKUP_CLOUD_CONTAINER=clouddrive
MEMORYBRIDGE_BACKUP_CLOUD_MOUNT=/CloudDrive
MEMORYBRIDGE_BACKUP_REMOTE_ROOT=/CloudDrive/qdrant-memory-backup
MEMORYBRIDGE_BACKUP_RETENTION=5
# Set this only when the Qdrant deployment requires an API key.
# MEMORYBRIDGE_BACKUP_QDRANT_API_KEY=
