# Optional overrides for the daily local conversation summarizer.
# The production deployment already supplies MEMORYBRIDGE_EMBED_API_KEY through
# /etc/memorybridge.env; it is used as the local New API key unless this value is
# explicitly set.
MEMORYBRIDGE_SUMMARY_BASE_URL=http://127.0.0.1:8199/v1
MEMORYBRIDGE_SUMMARY_MODEL=qwen3:4b-instruct
MEMORYBRIDGE_SUMMARY_SOURCE_AGENTS=codex,hermes,openclaw
MEMORYBRIDGE_SUMMARY_TIMEZONE=Asia/Shanghai
MEMORYBRIDGE_SUMMARY_LOOKBACK_DAYS=7
# The default 45-second timeout keeps a broken upstream model channel from
# holding the daily job for minutes; failed dates are retried within the lookback.
MEMORYBRIDGE_SUMMARY_TIMEOUT=45
# MEMORYBRIDGE_SUMMARY_API_KEY=
# MEMORYBRIDGE_SUMMARY_CODEX_ROOTS=/root/.codex/sessions,/root/.codex/archived_sessions
# MEMORYBRIDGE_SUMMARY_STATE=/var/lib/memorybridge/daily-summary/state.json
