[Unit]
Description=MemoryBridge daily local conversation summarizer
After=network-online.target memorybridge-worker.service memorybridge-spool-root.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/memorybridge.env
EnvironmentFile=-/etc/memorybridge-daily-summary.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/memorybridge
ExecStart=/opt/memorybridge-venv/bin/python -m memorybridge.daily_summary
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadOnlyPaths=/root/.codex
ReadWritePaths=/root/.memorybridge /var/lib/memorybridge

[Install]
WantedBy=multi-user.target
