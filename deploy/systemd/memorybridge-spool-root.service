[Unit]
Description=MemoryBridge local spool synchronizer (root client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/root/.config/memorybridge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/.local/bin/memorybridge spool-sync --daemon
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/root/.memorybridge

[Install]
WantedBy=multi-user.target
