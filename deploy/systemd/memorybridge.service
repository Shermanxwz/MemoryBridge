[Unit]
Description=MemoryBridge MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=memorybridge
Group=memorybridge
EnvironmentFile=/etc/memorybridge.env
ExecStart=/opt/memorybridge/.venv/bin/memorybridge-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/memorybridge

[Install]
WantedBy=multi-user.target
