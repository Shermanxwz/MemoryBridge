[Unit]
Description=MemoryBridge local spool synchronizer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/memorybridge spool-sync --daemon
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/memorybridge.env

[Install]
WantedBy=default.target
