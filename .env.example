# Qdrant (MemoryBridge should normally run on the same host and use localhost)
MEMORYBRIDGE_QDRANT_URL=http://127.0.0.1:6333
MEMORYBRIDGE_QDRANT_API_KEY=
MEMORYBRIDGE_WRITE_COLLECTION=memorybridge_raw
MEMORYBRIDGE_SOURCE_COLLECTIONS=
MEMORYBRIDGE_VECTOR_COLLECTIONS=
MEMORYBRIDGE_FALLBACK_COLLECTION=memorybridge_fallback
MEMORYBRIDGE_META_COLLECTION=memorybridge_meta

# MCP network + auth
MEMORYBRIDGE_HOST=127.0.0.1
MEMORYBRIDGE_PORT=8765
MEMORYBRIDGE_PUBLIC_MCP_URL=https://memory.example.com/mcp
# ChatGPT-only optional MCP Apps archive card; leave empty/false for legacy clients.
MEMORYBRIDGE_CHATGPT_UI=false
# For OAuth mode this must be the authorization/OIDC issuer exactly as the provider returns it.
MEMORYBRIDGE_AUTH_ISSUER=https://auth.example.com
MEMORYBRIDGE_AUTH_REQUIRED_SCOPES=memory

# Server auth mode A: operator-managed opaque bearer tokens (Codex/Hermes/OpenClaw compatible).
# Use a distinct long random token per device. Leave this empty when OAuth introspection below is enabled.
MEMORYBRIDGE_BEARER_TOKENS=replace-with-a-long-random-token

# Server auth mode B: OAuth 2.1 resource server for ChatGPT/custom MCP clients.
# MemoryBridge verifies access tokens through an RFC 7662 introspection endpoint owned by your authorization server.
# Do not enable this at the same time as MEMORYBRIDGE_BEARER_TOKENS.
MEMORYBRIDGE_OAUTH_INTROSPECTION_URL=
MEMORYBRIDGE_OAUTH_INTROSPECTION_CLIENT_ID=
MEMORYBRIDGE_OAUTH_INTROSPECTION_CLIENT_SECRET=
MEMORYBRIDGE_OAUTH_INTROSPECTION_TIMEOUT=10
# Optional but strongly recommended for the sealed single-trust-domain ChatGPT deployment.
# Comma-separate the exact OAuth/OIDC `sub` values allowed to access this shared memory domain.
# Everyone listed here shares the same configured MemoryBridge collections; this is not row-level tenant isolation.
MEMORYBRIDGE_OAUTH_ALLOWED_SUBJECTS=

# Optional local-model fallback through an OpenAI-compatible gateway (New API works)
MEMORYBRIDGE_EMBED_BASE_URL=https://new-api.example.com/v1
MEMORYBRIDGE_EMBED_API_KEY=
MEMORYBRIDGE_EMBED_MODEL=qwen3-embedding:0.6b
# Current TYC-Memory-Embedding route returns 1024 dimensions. Leave empty for a provider whose dimension is unknown.
MEMORYBRIDGE_EMBED_DIM=1024
MEMORYBRIDGE_EMBED_TIMEOUT=30

# Retrieval fallback bounds. Lexical is intentionally bounded because it is a last-resort path.
MEMORYBRIDGE_LEXICAL_MAX_POINTS=5000
MEMORYBRIDGE_SEARCH_TOP_K=12

# Unattended worker + archive. ARCHIVE_DIR can be a CloudDrive2-mounted path.
MEMORYBRIDGE_WORKER_INTERVAL=5
MEMORYBRIDGE_SNAPSHOT_INTERVAL=86400
MEMORYBRIDGE_SNAPSHOT_RETENTION=14
MEMORYBRIDGE_ARCHIVE_DIR=/var/lib/memorybridge/archive
MEMORYBRIDGE_SNAPSHOT_COLLECTIONS=

# Local capture bridge on Codex/OpenClaw/Hermes devices
MEMORYBRIDGE_MCP_URL=https://memory.example.com/mcp
MEMORYBRIDGE_MCP_TOKEN=replace-with-the-device-token
MEMORYBRIDGE_SPOOL_DIR=~/.memorybridge/spool
