# Qdrant (MemoryBridge should normally run on the same host and use localhost)
MEMORYBRIDGE_QDRANT_URL=http://127.0.0.1:6333
MEMORYBRIDGE_QDRANT_API_KEY=
MEMORYBRIDGE_WRITE_COLLECTION=memorybridge_raw
MEMORYBRIDGE_SOURCE_COLLECTIONS=
MEMORYBRIDGE_VECTOR_COLLECTIONS=
MEMORYBRIDGE_FALLBACK_COLLECTION=memorybridge_fallback
MEMORYBRIDGE_META_COLLECTION=memorybridge_meta

# MCP network + auth
MEMORYBRIDGE_HOST=127.0.0.1
MEMORYBRIDGE_PORT=8765
MEMORYBRIDGE_PUBLIC_MCP_URL=https://memory.example.com/mcp
MEMORYBRIDGE_BEARER_TOKENS=replace-with-a-long-random-token
MEMORYBRIDGE_AUTH_ISSUER=https://memory.example.com

# Optional local-model fallback through an OpenAI-compatible gateway (New API works)
MEMORYBRIDGE_EMBED_BASE_URL=https://new-api.example.com/v1
MEMORYBRIDGE_EMBED_API_KEY=
MEMORYBRIDGE_EMBED_MODEL=qwen3-embedding:0.6b
# Leave empty to accept provider output and create a matching fallback collection.
MEMORYBRIDGE_EMBED_DIM=
MEMORYBRIDGE_EMBED_TIMEOUT=30

# Retrieval fallback bounds. Lexical is intentionally bounded because it is a last-resort path.
MEMORYBRIDGE_LEXICAL_MAX_POINTS=5000
MEMORYBRIDGE_SEARCH_TOP_K=12

# Unattended worker + archive. ARCHIVE_DIR can be a CloudDrive2-mounted path.
MEMORYBRIDGE_WORKER_INTERVAL=5
MEMORYBRIDGE_SNAPSHOT_INTERVAL=86400
MEMORYBRIDGE_SNAPSHOT_RETENTION=14
MEMORYBRIDGE_ARCHIVE_DIR=/var/lib/memorybridge/archive
MEMORYBRIDGE_SNAPSHOT_COLLECTIONS=

# Local capture bridge on Codex/OpenClaw/Hermes devices
MEMORYBRIDGE_MCP_URL=https://memory.example.com/mcp
MEMORYBRIDGE_MCP_TOKEN=replace-with-the-device-token
MEMORYBRIDGE_SPOOL_DIR=~/.memorybridge/spool
